{
  "$schema": "https://biomejs.dev/schemas/2.5.4/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": ["**", "!**/src/routeTree.gen.ts", "!packages/db/drizzle"]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 80
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "a11y": {
        "noRedundantAlt": "off",
        "noStaticElementInteractions": "off",
        "useAriaPropsForRole": "off",
        "useButtonType": "off",
        "useFocusableInteractive": "off",
        "useKeyWithClickEvents": "off",
        "useSemanticElements": "off"
      },
      "correctness": {
        "noUnreachable": "off",
        "useExhaustiveDependencies": "off",
        "useHookAtTopLevel": "error",
        "noUnusedImports": {
          "fix": "safe",
          "level": "warn"
        }
      },
      "complexity": {
        "noUselessSwitchCase": "on"
      },
      "performance": {
        "noDynamicNamespaceImportAccess": "off"
      },
      "security": {
        "noDangerouslySetInnerHtml": "off"
      },
      "style": {
        "noCommonJs": "error",
        "noNonNullAssertion": "off",
        "useConsistentArrayType": {
          "level": "error",
          "options": { "syntax": "generic" }
        },
        "useNodejsImportProtocol": "error"
      },
      "suspicious": {
        "noShadow": "warn",
        "noAssignInExpressions": "off",
        "noApproximativeNumericConstant": "off",
        "noArrayIndexKey": "off",
        "noDocumentCookie": "off",
        "noDoubleEquals": "off",
        "useAwait": "warn",
        "useIterableCallbackReturn": "off",
        "noAlert": "off"
      }
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on",
        "useSortedPackageJson": "on"
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "asNeeded",
      "trailingCommas": "es5"
    }
  },
  "json": {
    "formatter": {
      "indentStyle": "space"
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  }
}

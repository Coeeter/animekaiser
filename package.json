{
  "name": "animekaiser",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "format": "biome format --write .",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "prepare": "effect-tsgo patch",
    "test": "bun test apps packages",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install chromium",
    "typecheck": "turbo typecheck"
  },
  "overrides": {
    "@effect/platform-node-shared": "4.0.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.3",
    "@effect/tsgo": "^0.21.0",
    "@playwright/test": "^1.61.1",
    "effect": "4.0.2",
    "turbo": "^2.9.15",
    "typescript": "^7.0.2"
  },
  "packageManager": "bun@1.4.4",
  "engines": {
    "node": ">=20"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "lightningcss"
    ]
  }
}

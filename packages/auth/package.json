{
  "name": "@workspace/auth",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "exports": {
    ".": "./src/index.ts",
    "./client": "./src/client.ts"
  },
  "scripts": {
    "lint": "eslint",
    "format": "prettier --write \"**/*.{ts,tsx}\" --ignore-path ../../.prettierignore",
    "typecheck": "tsc --noEmit",
    "auth:generate": "bunx --bun @better-auth/cli generate --config script/auth-cli.ts --output ../db/src/schema/auth.ts"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "^1.6.14",
    "@better-auth/passkey": "^1.6.14",
    "@workspace/db": "workspace:*",
    "better-auth": "^1.6.14",
    "drizzle-orm": "^0.45.2",
    "effect": "^3.21.3"
  },
  "devDependencies": {
    "@types/node": "^25.9.2",
    "typescript": "^6"
  }
}

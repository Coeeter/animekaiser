{
  "name": "@workspace/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "db:generate": "bunx --bun drizzle-kit generate --config ./drizzle.config.ts",
    "db:migrate": "bunx --bun drizzle-kit migrate --config ./drizzle.config.ts",
    "db:studio": "bunx --bun drizzle-kit studio --config ./drizzle.config.ts",
    "dev": "docker compose up",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "drizzle-kit": "^0.31.10",
    "drizzle-orm": "^0.45.2",
    "effect": "^3.21.3",
    "pg": "^8.21.0"
  },
  "devDependencies": {
    "@types/node": "^25.9.2",
    "@types/pg": "^8.20.0",
    "typescript": "^6"
  }
}

{
  "name": "@animekaiser/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "bun build ./src/index.ts --outdir ./dist --target bun",
    "dev": "bun --watch src/index.ts",
    "start": "bun ./dist/index.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@animekaiser/auth": "workspace:*",
    "@animekaiser/core": "workspace:*",
    "@animekaiser/db": "workspace:*",
    "@animekaiser/domain": "workspace:*",
    "@animekaiser/rpc": "workspace:*",
    "@effect/platform-bun": "4.0.2",
    "effect": "4.0.2",
    "resend": "^6.12.4"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/node": "^25.9.2",
    "typescript": "^7.0.2"
  }
}
